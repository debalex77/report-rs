{
  "name": "Products with nested groups",
  "data_sources": [
    {
      "name": "main",
      "connection": {
        "type": "sqlite",
        "path": "test.sqlite3"
      },
      "queries": [
        {
          "name": "products",
          "sql": "SELECT pr.id, pr.category_id, ct.name AS categorie, pr.available, pr.name, pr.unit, pr.price FROM products pr INNER JOIN categories ct ON ct.id = pr.category_id ORDER BY pr.category_id, pr.available, pr.name;"
        }
      ]
    }
  ],
  "pages": [
    {
      "size": "A4",
      "orientation": "Portrait",
      "margins": {
        "left": 10.0,
        "top": 10.0,
        "right": 10.0,
        "bottom": 10.0
      },
      "bands": [
        {
          "kind": "ReportHeader",
          "height": 16.0,
          "items": [
            {
              "type": "Text",
              "name": "reportTitle",
              "x": 0.0,
              "y": 1.0,
              "width": 190.0,
              "height": 12.0,
              "text": "PRODUCTS — NESTED GROUPS",
              "font_size": 18.0,
              "font_family": "DejaVu Sans",
              "bold": true,
              "italic": false,
              "text_color": {
                "r": 31,
                "g": 55,
                "b": 83,
                "a": 255
              },
              "horizontal_align": "Center",
              "vertical_align": "Center",
              "word_wrap": false,
              "auto_height": false,
              "padding": {
                "left": 1.0,
                "top": 1.0,
                "right": 1.0,
                "bottom": 1.0
              },
              "background": null,
              "border": {
                "left": false,
                "top": false,
                "right": false,
                "bottom": true,
                "width": 0.6
              }
            }
          ]
        },
        {
          "kind": {
            "GroupHeader": {
              "source": "products",
              "field": "category_id",
              "repeat_on_each_page": true
            }
          },
          "height": 9.0,
          "items": [
            {
              "type": "Text",
              "name": "categoryHeader",
              "x": 0.0,
              "y": 1.0,
              "width": 190.0,
              "height": 8.0,
              "text": "CATEGORY ${category_id}: ${categorie}",
              "value_type": "Expression",
              "font_size": 13.0,
              "font_family": "DejaVu Sans",
              "bold": true,
              "italic": false,
              "text_color": {
                "r": 255,
                "g": 255,
                "b": 255,
                "a": 255
              },
              "horizontal_align": "Left",
              "vertical_align": "Center",
              "word_wrap": false,
              "auto_height": false,
              "padding": {
                "left": 3.0,
                "top": 0.5,
                "right": 1.0,
                "bottom": 0.5
              },
              "background": {
                "r": 42,
                "g": 82,
                "b": 125,
                "a": 255
              },
              "border": null
            }
          ]
        },
        {
          "kind": {
            "GroupHeader": {
              "source": "products",
