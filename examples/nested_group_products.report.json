              "background": {
                "r": 239,
                "g": 243,
                "b": 247,
                "a": 255
              },
              "border": {
                "left": true,
                "top": true,
                "right": true,
                "bottom": true,
                "width": 0.3
              }
            }
          ]
        },
        {
          "kind": {
            "Data": {
              "source": "products"
            }
          },
          "height": 7.0,
          "items": [
            {
              "type": "Text",
