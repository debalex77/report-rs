{
  "name": "Products grouped by category",
  "data_sources": [
    {
      "name": "main",
      "connection": {
        "type": "sqlite",
        "path": "test.sqlite3"
      },
      "queries": [
        {
          "name": "products",
          "sql": "SELECT pr.id,\n       pr.category_id,\n       pr.name,\n       pr.description,\n       pr.unit,\n       pr.price,\n       pr.available,\n       ct.name AS categorie\n  FROM products pr\n  INNER JOIN categories ct ON pr.category_id = ct.id\n ORDER BY category_id,\n          categorie;"
        }
      ]
    }
  ],
