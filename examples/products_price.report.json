      "queries": [
        {
          "name": "products",
          "sql": "SELECT id,\n       category_id,\n       name,\n       description,\n       unit,\n       price,\n       available,\n       created_at\n  FROM products LIMIT 10;"
        },
        {
          "name": "employees",
          "sql": "SELECT id,\n       restaurant_id,\n       first_name,\n       last_name,\n       first_name ||' '|| last_name as fullName,\n       position,\n       phone,\n       salary,\n       active\n  FROM employees WHERE position = :position;"
